# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# ── 后台管理员（必填） ──────────────────────
ADMIN_USER=admin
ADMIN_PASS=change-me

# ── MySQL（推荐：宿主机 1Panel 安装的 MySQL） ─
# 首次启动自动建库（utf8mb4）并灌入种子数据
SHICI_MYSQL_DSN=root:你的密码@tcp(host.docker.internal:3306)/shici?charset=utf8mb4&parseTime=true&loc=Local

# ── 不用 MySQL？留空 SHICI_MYSQL_DSN 即用容器内 SQLite ──

# ── 对外端口 ────────────────────────────────
APP_PORT=8080
