# 复制为 .env 后填写真实配置（.env 已被 .gitignore 忽略，不会提交）：
#   cp .env.example .env && chmod 600 .env
#
# 程序启动时自动读取同目录 .env；已存在的环境变量优先（容器 / systemd 注入可覆盖）。

# ── 后台管理员（必填，请改成强密码） ──────────────
ADMIN_USER=admin
ADMIN_PASS=请改成强密码
# 也可用 bcrypt 哈希代替明文：ADMIN_HASH=$2a$10$...

# ── MySQL（poetry_charity 库，poems 表 → 诗词） ───
#
# 支持两种写法：
#   1) URL 形式（推荐）：mysql://用户名:密码@主机:端口/库名
#   2) go-sql-driver 原生 DSN：user:pass@tcp(host:3306)/db
#
# 省略库名时默认使用 poetry_charity（可用 SHICI_MYSQL_DB 覆盖）；
# 也兼容 DATABASE_URL。表已存在时不再执行 DDL，只读账号也能直接运行。
#
# 权限建议：站点只读运行需要 SELECT；若要用后台维护诗词，还需
# INSERT / UPDATE / DELETE（否则后台保存会被数据库拒绝，启动日志会提示只读）。
SHICI_MYSQL_DSN=mysql://用户名:密码@主机:22213/poetry_charity
SHICI_MYSQL_DB=poetry_charity

# ── 不用 MySQL？注释掉 SHICI_MYSQL_DSN 即用 SQLite ──
# SHICI_DB=data/shici.db

# ── 监听地址与端口 ──────────────────────────────
# 放在反向代理（Caddy/Nginx）之后时设为回环地址，应用端口不对外暴露
# SHICI_HOST=127.0.0.1
# 服务监听端口
PORT=8080
# docker compose 映射到宿主机的端口
APP_PORT=8080
