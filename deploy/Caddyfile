# Caddy 反向代理（站点地址与上游均来自环境变量，配置里不写死端口/IP）
#
# 依赖环境文件（例如 /etc/caddy/caddy.env，配合 systemd EnvironmentFile）：
#   SITE_ADDRESS=:80                      # 有域名后改为域名，如 shici.example.com（自动 HTTPS）
#   SHICI_UPSTREAM=127.0.0.1:18010        # 应用只监听回环，端口不对外暴露
#
# 应用侧对应配置（.env）：
#   SHICI_HOST=127.0.0.1
#   PORT=18010

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy {$SHICI_UPSTREAM}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
	}

	log {
		output file /var/log/caddy/shici-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
